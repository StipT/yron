{
  "servers": {
    "interactive": {
      "command": "npx",
      "args": [
        "-y",
        "@rawwee/interactive-mcp",
        "-t",
        "1200",
        "--disable-tools",
        "message_complete_notification"
      ],
      "type": "stdio"
    },
    "repo-docs-libs": {
      "type": "stdio",
      "command": "node",
      "args": [
        "tools/mcp/repo-docs-libs-server.cjs"
      ]
    },
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ],
      "type": "stdio"
    }
  }
}
